    {
      "parameters": {
        "jsCode": "// Decide o destino olhando AS DUAS planilhas + o conteúdo da mensagem.\n// Sempre devolve exatamente 1 item (nunca vazio), para o fluxo não morrer aqui.\n\nconst so8 = (v) => String(v || '').replace(/\\D/g, '').slice(-8);\n\nconst info = $('Extrair remetente').first().json;\nconst alvo = info.telefone8;\nconst texto = String(info.texto || '').trim();\nconst body = $('Webhook Evolution IN').first().json.body ?? $('Webhook Evolution IN').first().json;\n\nfunction linhas(nome) {\n  try {\n    return $(nome).all().map((i) => i.json).filter((o) => o && o.telefone !== undefined);\n  } catch (e) {\n    return [];\n  }\n}\n\nconst orcamentos = linhas('Ler aba Orcamentos');\nconst agenda = linhas('Ler aba Agenda');\n\nconst temOrcamentoAberto = orcamentos.some(\n  (o) => so8(o.telefone) === alvo && String(o.status || '').trim() === 'enviado'\n);\nconst temConsultaPendente = agenda.some(\n  (a) => so8(a.telefone) === alvo && String(a.status || '').trim() === 'aguardando resposta'\n);\n\nconst ehRespostaDeMenu = ['1', '2', '3'].includes(texto);\n\nlet destino;\nlet motivo;\n\nif (temConsultaPendente && ehRespostaDeMenu) {\n  destino = 'A1';\n  motivo = 'resposta de menu (1/2/3) com consulta aguardando';\n} else if (temOrcamentoAberto) {\n  destino = 'A2';\n  motivo = 'orcamento com status enviado para este telefone';\n} else if (temConsultaPendente) {\n  destino = 'A1';\n  motivo = 'consulta aguardando resposta para este telefone';\n} else {\n  destino = 'A1';\n  motivo = 'nada encontrado — padrao clinica';\n}\n\nreturn [\n  {\n    json: {\n      destino,\n      motivo,\n      telefone8: alvo,\n      texto,\n      temConsultaPendente,\n      temOrcamentoAberto,\n      body,\n    },\n  },\n];"
      },
