        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "COLE_AQUI_SUA_EVOLUTION_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $('Orçamento aberto deste cliente').item.json.vendedor_telefone }}"
            },
            {
              "name": "text",
              "value": "={{ '🔥 Cliente respondeu o orçamento!\\n\\n' + $('Orçamento aberto deste cliente').item.json.cliente + ' — ' + $('Orçamento aberto deste cliente').item.json.descricao + '\\nValor: R$ ' + $('Orçamento aberto deste cliente').item.json.valor + '\\nTelefone: ' + $('Orçamento aberto deste cliente').item.json.telefone + '\\n\\nDisse: \"' + $('Extrair dados').first().json.texto + '\"\\n\\nFala com ele agora que está quente!' }}"
            }
          ]
        },
        "options": {}
      },
