    {
      "parameters": {
        "jsCode": "// Decide o destino da mensagem e devolve UM item (nunca vazio).\nconst alvo = $('Extrair remetente').first().json.telefone8;\nconst body = $('Webhook Evolution IN').first().json.body ?? $('Webhook Evolution IN').first().json;\n\nlet temOrcamentoAberto = false;\ntry {\n  const orcamentos = $input.all().map((i) => i.json);\n  temOrcamentoAberto = orcamentos.some(\n    (o) =>\n      String(o.telefone || '').replace(/\\D/g, '').slice(-8) === alvo &&\n      String(o.status || '').trim() === 'enviado'\n  );\n} catch (e) {\n  temOrcamentoAberto = false;\n}\n\nreturn [\n  {\n    json: {\n      destino: temOrcamentoAberto ? 'A2' : 'A1',\n      telefone8: alvo,\n      body,\n    },\n  },\n];"
      },
